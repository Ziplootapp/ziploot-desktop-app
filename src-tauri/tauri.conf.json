{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "ZipLoot Desktop",
  "version": "1.0.0",
  "identifier": "app.ziploot.desktop",
  "build": {
    "frontendDist": "https://ziploot.app"
  },
  "app": {
    "windows": [
      {
        "title": "ZipLoot — Native Cyber Desktop App",
        "url": "https://ziploot.app",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
